# Tunables for the agent VM. Loaded by the justfile (dotenv).
# Safe to override per-host — these are defaults, not constants.

VM_NAME=inca-vm

# Base image. MUST be a cloud variant (ships cloud-init) or user-data is ignored.
# Incus has no 'ubuntu:' remote (that was LXD) — use the '/cloud' variant on the
# images: remote. Plain 'images:ubuntu/<rel>' (no /cloud) lacks cloud-init.
VM_IMAGE=images:ubuntu/26.04/cloud

# Resources. MEM_MAX is the ceiling the guest *thinks* it has. The host gets freed
# pages back via virtio-balloon free-page-reporting, which Incus (7.0.1) does not
# enable on its own — the justfile passes the qemu override and cloud-init turns the
# guest's reporting order down so fragmented free memory is covered too. Without both
# halves the host ends up paying MEM_MAX for real. See TRADEOFFS.md.
VM_CPU=4
VM_MEM_MAX=8GiB

# Root disk size. The dir storage backend gives VMs a sparse image, so this is a
# ceiling, not an upfront allocation — only actual usage hits the host disk.
# The golden image alone is ~8GB, so keep this well above that to leave room for
# repos. Grow an existing VM later with `just resize-disk <size> <name>`.
VM_ROOT_SIZE=40GiB

# Guest user created by cloud-init. Credentials are NOT baked into the golden
# image; the host SSH key is injected at `just up` and agent auth at `just login`.
VM_USER=dev

# Incus storage pool + bridge network. `just init` creates them if missing.
VM_STORAGE=default
VM_NETWORK=incusbr0

# Alias for the published golden image (tools installed, no creds).
GOLDEN_IMAGE=inca-golden

# Host-side home for shared project trees. INCA_WORK/<vm>/<project> is shared over
# virtiofs into <vm> at work/<project>; the host copy is the source of truth.
# Defaults to ~/inca-work (computed in the justfile). Override with an ABSOLUTE
# path — dotenv does not expand $HOME here:
# INCA_WORK=/home/you/inca-work

# Root under which config/agent-config.txt paths are resolved by push-config /
# pull-config. Defaults to $HOME (your live dotfiles; computed in the justfile). If
# you no longer run agents on the host and want all agent config in one collected
# place, point this at that dir (ABSOLUTE path — dotenv does not expand $HOME):
# INCA_CONFIG_HOME=/home/you/inca-config
