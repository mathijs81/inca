# Tunables for the agent VM. Loaded by the justfile (dotenv).
# Safe to override per-host — these are defaults, not constants.

VM_NAME=agentbox

# Base image. MUST be a cloud variant (ships cloud-init) or user-data is ignored.
# Incus has no 'ubuntu:' remote (that was LXD) — use the '/cloud' variant on the
# images: remote. Plain 'images:ubuntu/<rel>' (no /cloud) lacks cloud-init.
VM_IMAGE=images:ubuntu/26.04/cloud

# Resources. MEM_MAX is the ceiling the guest *thinks* it has; with
# virtio-balloon free-page-reporting the host only backs what's actually used.
# Keep MEM_MAX comfortably under host RAM (account for host + swap headroom).
VM_CPU=4
VM_MEM_MAX=8GiB

# Root disk size. The dir storage backend gives VMs a sparse image, so this is a
# ceiling, not an upfront allocation — only actual usage hits the host disk.
# The golden image alone is ~8GB, so keep this well above that to leave room for
# repos. Grow an existing VM later with `just resize-disk <size> <name>`.
VM_ROOT_SIZE=40GiB

# Guest user created by cloud-init. Credentials are NOT baked into the golden
# image; the host SSH key is injected at `just up` and agent auth at `just login`.
VM_USER=dev

# Incus storage pool + bridge network. `just init` creates them if missing.
VM_STORAGE=default
VM_NETWORK=incusbr0

# Alias for the published golden image (tools installed, no creds).
GOLDEN_IMAGE=agentbox-golden
